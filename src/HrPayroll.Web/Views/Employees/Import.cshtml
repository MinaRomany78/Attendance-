@model HrPayroll.Web.ViewModels.EmployeeImportVm
@{ Layout = "_Layout"; ViewData["Title"] = "استيراد الموظفين من Excel"; }
<h2>استيراد الموظفين من Excel</h2>
<p class="text-muted">ارفع ملف .xlsx مطابق لقالب الأعمدة المعتمد. سيتم عرض معاينة قبل الحفظ النهائي.</p>

<div class="card mb-3">
    <div class="card-body">
        <h5>تعليمات الأعمدة</h5>
        <div class="table-responsive">
            <table class="table table-sm">
                <thead><tr><th>#</th><th>العمود</th><th>إلزامي</th><th>الوصف</th></tr></thead>
                <tbody>
                @for (var i = 0; i < Model.Columns.Count; i++)
                {
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@Model.Columns[i]</td>
                        <td>@(Model.Required[i] ? "نعم" : "اختياري")</td>
                        <td>@Model.ColumnHints[i]</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<form asp-action="Import" method="post" enctype="multipart/form-data" class="card">
    <div class="card-body">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">ملف Excel (.xlsx حتى 10MB)</label>
                <input type="file" name="file" accept=".xlsx" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">وضع الاستيراد</label>
                <select name="mode" class="form-select">
                    <option value="Upsert">إضافة الجديد وتحديث الموجود</option>
                    <option value="InsertOnly">إضافة الجديد فقط</option>
                    <option value="UpdateOnly">تحديث الموجود فقط</option>
                </select>
            </div>
            <div class="col-12">
                <button class="btn btn-primary" type="submit">معاينة الاستيراد</button>
                @await Html.PartialAsync("_BackHome", "عودة")
            </div>
        </div>
    </div>
</form>

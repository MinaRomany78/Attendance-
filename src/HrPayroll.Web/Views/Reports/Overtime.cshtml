@model HrPayroll.Web.ViewModels.OvertimeReportVm
@{ Layout = "_Layout"; ViewData["Title"] = "تقرير الوقت الإضافي"; }
<h2>تقرير الوقت الإضافي</h2>
<form method="get" class="card mb-3 no-print">
    <div class="card-body row g-2">
        <div class="col-md-3"><label class="form-label">من</label><input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">إلى</label><input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">القسم</label><input type="text" name="department" value="@Model.Department" class="form-control" /></div>
        <div class="col-md-3 d-flex align-items-end gap-2">
            <button class="btn btn-primary" type="submit">عرض</button>
            <button class="btn btn-outline-secondary" type="button" onclick="window.print()">طباعة</button>
        </div>
    </div>
</form>
<div class="card">
    <div class="card-body">
        <h5>إجمالي الساعات: @Model.TotalHours ساعة (@(Model.TotalAmount.ToString("N2")))</h5>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead><tr><th>الموظف</th><th>الكود</th><th>القسم</th><th>الساعات</th><th>المبلغ</th></tr></thead>
                <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr><td>@r.EmployeeName</td><td>@r.EmployeeCode</td><td>@r.DepartmentName</td><td>@r.OvertimeHours</td><td>@r.OvertimeAmount.ToString("N2")</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="mt-3">
    @await Html.PartialAsync("_BackHome", "عودة")
</div>

@model HrPayroll.Web.ViewModels.DailyReportVm
@{ Layout = "_Layout"; ViewData["Title"] = "التقرير اليومي"; }
<h2>التقرير اليومي — @Model.Date.ToString("yyyy-MM-dd")</h2>
<form method="get" class="card mb-3 no-print">
    <div class="card-body row g-2">
        <div class="col-md-3"><label class="form-label">التاريخ</label><input type="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">القسم</label><input type="text" name="department" value="@Model.Department" class="form-control" /></div>
        <div class="col-md-3 d-flex align-items-end gap-2">
            <button class="btn btn-primary" type="submit">عرض</button>
            <button class="btn btn-outline-secondary" type="button" onclick="window.print()">طباعة</button>
        </div>
    </div>
</form>
<div class="row mb-3">
    <div class="col-md-3"><div class="card"><div class="card-body text-center"><div class="display-6">@Model.Present</div><div class="text-muted">حاضر</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body text-center"><div class="display-6">@Model.Absent</div><div class="text-muted">غائب</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body text-center"><div class="display-6">@Model.Late</div><div class="text-muted">متأخر</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body text-center"><div class="display-6">@Model.OnLeave</div><div class="text-muted">إجازة</div></div></div></div>
</div>
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped">
                <thead><tr><th>الموظف</th><th>الكود</th><th>القسم</th><th>الحالة</th><th>الدخول</th><th>الخروج</th><th>التأخير</th><th>الإضافي</th></tr></thead>
                <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@r.EmployeeName</td><td>@r.EmployeeCode</td><td>@r.DepartmentName</td>
                        <td>@r.StatusText</td>
                        <td>@(r.CheckIn?.ToString("HH:mm") ?? "—")</td>
                        <td>@(r.CheckOut?.ToString("HH:mm") ?? "—")</td>
                        <td>@r.LateMinutes</td><td>@r.OvertimeMinutes</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="mt-3">
    @await Html.PartialAsync("_BackHome", "عودة")
</div>

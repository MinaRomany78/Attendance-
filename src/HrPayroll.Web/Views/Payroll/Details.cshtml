@using HrPayroll.Web.Controllers
@model HrPayroll.Web.ViewModels.PayrollDetailsVm
@{ Layout = "_Layout"; ViewData["Title"] = "تفاصيل بند المرتب"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>تفاصيل بند المرتب</h2>
        <p class="text-muted mb-0">@(Model.EmployeeName) — @(Model.RunLabel)</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Payslip" asp-route-id="@Model.ItemId">قسيمة الراتب</a>
        @await Html.PartialAsync("_BackHome", "عودة")
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row small">
            <div class="col-md-4"><strong>رقم الموظف:</strong> @Model.EmployeeCode</div>
            <div class="col-md-4"><strong>الأساسي:</strong> @Model.BasicSalary.ToString("N2")</div>
            <div class="col-md-4"><strong>أجر الساعة:</strong> @Model.HourlyRate.ToString("N4")</div>
            <div class="col-md-4"><strong>أيام الغياب المعتمدة:</strong> @Model.AbsenceDays (@(Model.AbsenceAmount.ToString("N2")))</div>
            <div class="col-md-4"><strong>الأصلية:</strong> @Model.OriginalAbsenceDays</div>
            <div class="col-md-4"><strong>إجازة سنوية:</strong> @Model.AnnualLeaveDays يوم (رصيد @Model.AnnualLeaveBalance)</div>
            <div class="col-md-4"><strong>المتأخرات:</strong> @Model.UnpaidCarryoverAmount.ToString("N2")</div>
            <div class="col-md-4"><strong>إضافي معتمد:</strong> @Model.PaidOvertimeHours ساعة (@(Model.OvertimeAmount.ToString("N2")))</div>
            <div class="col-md-4"><strong>إضافي فعلي:</strong> @Model.RawOvertimeHours ساعة</div>
            <div class="col-md-4"><strong>مكافآت:</strong> @Model.Bonuses.ToString("N2")</div>
            <div class="col-md-4"><strong>تأخير:</strong> @Model.LateMinutes دقيقة (@(Model.LateAmount.ToString("N2")))</div>
            <div class="col-md-4"><strong>خصومات:</strong> @Model.DeductionsTotal.ToString("N2")</div>
            <div class="col-md-4"><strong>سُلف:</strong> @Model.AdvancesTotal.ToString("N2")</div>
            <div class="col-md-4"><strong>أقساط قروض:</strong> @Model.LoanInstallmentsTotal.ToString("N2")</div>
            <div class="col-md-4"><strong>تعديلات:</strong> @Model.AdjustmentsTotal.ToString("N2")</div>
            <div class="col-md-4"><strong>الإجمالي المستحق:</strong> @Model.GrossEarnings.ToString("N2")</div>
            <div class="col-md-4"><strong>إجمالي الاستقطاعات:</strong> @Model.TotalDeductions.ToString("N2")</div>
            <div class="col-md-4"><strong>الصافي:</strong> @Model.NetSalary.ToString("N2")</div>
        </div>
    </div>
</div>

@if (Model.IsLocked)
{
    <div class="alert alert-warning">هذا البند تابع لتشغيل نهائي (مغلق).</div>
}
@if (Model.IsManuallyAdjusted)
{
    <div class="alert alert-info">تم تعديل هذا البند يدويًا بواسطة @Model.LastEditedBy</div>
}

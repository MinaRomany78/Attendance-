@using HrPayroll.Infrastructure.Services
@model PayslipData
@{ var i=Model.Item; var final=Model.RunStatus is PayrollStatus.Approved or PayrollStatus.Locked; ViewData["Title"]=$"كشف راتب {i.EmployeeName}"; }
<div class="payslip-shell card">
<header class="payslip-heading"><div><span class="eyebrow">@Model.CompanyName / كشف الراتب</span><h1>@i.EmployeeName</h1><p>@i.EmployeeCode · @(i.Department??"بدون قسم") · @(i.JobTitle??"بدون مسمى")</p><p>دورة الرواتب: <bdi>@Model.PeriodText</bdi></p></div><div class="btn-row no-print"><a class="btn btn-soft btn-sm" asp-action="PayslipPdf" asp-route-id="@i.PayrollItemId">تنزيل PDF</a><a class="btn btn-ghost btn-sm" asp-action="PayslipExcel" asp-route-id="@i.PayrollItemId">Excel</a><button type="button" class="btn btn-ghost btn-sm" data-print>طباعة</button><a class="btn btn-ghost btn-sm" asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month">رجوع للكشف</a></div></header>
<div class="card-body">
@if(!final){<div class="alert alert-info">كشف متوقع لدورة الرواتب الكاملة. المكتسب حتى التاريخ الموضح مستقل عن الراتب التعاقدي. لا يصبح الكشف نهائياً إلا بعد إغلاقه.</div>}
@if(i.AttendanceMissingDays>0){<div class="alert alert-warning">بيانات @i.AttendanceMissingDays يوم عمل غير مكتملة حتى @i.EarningsAsOf?.ToString("yyyy-MM-dd"). يجب استكمالها قبل الإغلاق. الأيام المفقودة والمستقبلية لم تُعتبر غياباً تلقائياً.</div>}
<div class="metric-grid">
<div class="metric"><div class="k">الراتب التعاقدي الشهري</div><div class="v">@((i.ContractBasicSalary??i.BasicSalary).ToString("N2"))<span class="unit">@Model.Currency</span></div><div class="meta">أساس الأجر 30 يوماً</div></div>
<div class="metric"><div class="k">المكتسب الأساسي حتى التاريخ</div><div class="v">@(i.EarnedBasicSalary?.ToString("N2")??"غير متاح")</div><div class="meta">@(i.EarningsAsOf?.ToString("yyyy-MM-dd")??"سجل تاريخي")</div></div>
<div class="metric"><div class="k">المكتسب الصافي حتى التاريخ</div><div class="v">@(i.EarnedNetSalary?.ToString("N2")??"غير متاح")</div><div class="meta">خصومات الفترة المكتسبة: @(i.EarnedDeductions?.ToString("N2")??"—")</div></div>
<div class="metric emphasis"><div class="k">@(final?"الصافي النهائي":"الصافي المتوقع للدورة")</div><div class="v">@i.NetSalary.ToString("N2")<span class="unit">@Model.Currency</span></div><div class="meta">@ExcelExportService.PayrollStatusText(Model.RunStatus)</div></div>
</div>
<div class="section-title">الأيام والأوقات المثبتة</div><div class="def-grid">
<div class="def"><div class="k">الحضور الفعلي</div><div class="v">@i.AttendanceDays يوم</div></div><div class="def"><div class="k">راحة مدفوعة</div><div class="v">@i.PaidRestDays يوم</div></div><div class="def"><div class="k">إجازة معتمدة مدفوعة</div><div class="v">@i.PaidLeaveDays.ToString("0.##") يوم</div></div><div class="def"><div class="k">غياب غير مدفوع</div><div class="v">@i.AbsenceDays.ToString("0.##") يوم</div></div>
<div class="def"><div class="k">إجازة بدون أجر</div><div class="v">@i.UnpaidLeaveDays.ToString("0.##") يوم</div></div><div class="def"><div class="k">التأخير</div><div class="v">@((i.LateMinutes/60m).ToString("0.##")) ساعة<small>@i.LateMinutes دقيقة</small></div></div><div class="def"><div class="k">الانصراف المبكر الخاضع للخصم</div><div class="v">@((i.EarlyLeaveMinutes/60m)?.ToString("0.##")??"غير مفصل") ساعة<small>بعد سماح الخروج</small></div></div><div class="def"><div class="k">الإضافي المحتسب</div><div class="v">@i.PaidOvertimeHours.ToString("0.##") ساعة<small>المعتمد @i.ApprovedOvertimeHours.ToString("0.##") · الخام @i.RawOvertimeHours.ToString("0.##")</small></div></div>
</div>
<div class="section-title">قياسات الوقت الخام قبل فترات السماح</div><div class="def-grid"><div class="def"><div class="k">التأخير الفعلي</div><div class="v">@i.ActualLateHours.ToString("0.##") ساعة<small>@((i.ActualLateHours*60m).ToString("0.##")) دقيقة</small></div></div><div class="def"><div class="k">الانصراف المبكر الفعلي</div><div class="v">@(i.ActualEarlyDepartureHours?.ToString("0.##")??"غير مفصل") ساعة<small>@((i.ActualEarlyDepartureHours*60m)?.ToString("0.##")) دقيقة</small></div></div><div class="def"><div class="k">الوقت المفقود داخل الوردية</div><div class="v">@(i.ActualMissingHours?.ToString("0.##")??"غير محسوم") ساعة<small>@((i.ActualMissingHours*60m)?.ToString("0.##")) دقيقة</small></div></div></div><div class="section-title">أسعار الحساب المحفوظة</div><div class="def-grid"><div class="def"><div class="k">الأجر اليومي</div><div class="v">@i.DailyRate.ToString("N2")<small>أساس القسمة: @i.DailyRateBasisDays يوماً</small></div></div><div class="def"><div class="k">أجر الساعة</div><div class="v">@i.HourlyRate.ToString("N2")<small>ساعات اليوم: @i.EffectiveWorkHoursPerDay.ToString("0.##")</small></div></div><div class="def"><div class="k">أجر الدقيقة</div><div class="v">@i.MinuteRate.ToString("0.########")</div></div><div class="def"><div class="k">معامل الإضافي</div><div class="v">@i.OvertimeMultiplier.ToString("0.##")</div></div></div>
<div class="payslip-columns">
<section class="payslip-panel"><h3>الاستحقاقات للدورة</h3><table class="data"><tbody>
<tr><td>الأساسي المستحق للدورة</td><td class="money">@i.BasicSalary.ToString("N2")</td></tr><tr><td>الإضافي المحتسب</td><td class="money">@i.OvertimeAmount.ToString("N2")</td></tr><tr><td>مكافآت</td><td class="money">@i.Bonuses.ToString("N2")</td></tr><tr><td>بدلات</td><td class="money">@i.Allowances.ToString("N2")</td></tr><tr><td>أيام إضافية (@i.AdditionalDaysCount.ToString("0.##"))</td><td class="money">@i.AdditionalDaysAmount.ToString("N2")</td></tr><tr class="total-row"><td>إجمالي الاستحقاقات</td><td class="money">@i.GrossEarnings.ToString("N2")</td></tr>
</tbody></table></section>
<section class="payslip-panel"><h3>الخصومات للدورة</h3><table class="data"><tbody>
<tr><td>التأخير</td><td class="money">@i.LateDeduction.ToString("N2")</td></tr><tr><td>الانصراف المبكر</td><td class="money">@(i.EarlyLeaveDeduction?.ToString("N2")??"غير مفصل تاريخياً")</td></tr><tr><td>نقص الوردية الشامل <small>يحل محل خصمي الوقت عند تطبيقه</small></td><td class="money">@(i.ShortageDeduction?.ToString("N2")??"غير مفصل تاريخياً")</td></tr><tr><td>الغياب</td><td class="money">@i.AbsenceDeduction.ToString("N2")</td></tr><tr><td>إجازة بدون أجر</td><td class="money">@i.UnpaidLeaveDeduction.ToString("N2")</td></tr>
@if(i.SalaryAdvancesPaid.HasValue){<tr><td>سلف مسجلة ومدفوعة سابقاً</td><td class="money">@i.SalaryAdvancesPaid.Value.ToString("N2")</td></tr><tr><td>أقساط القروض</td><td class="money">@((i.LoanInstallments??0m).ToString("N2"))</td></tr><tr><td>قروض سابقة</td><td class="money">@((i.LegacyLoanDeductions??0m).ToString("N2"))</td></tr>}else{<tr><td>السلف والقروض (سجل تاريخي)</td><td class="money">@i.LoansTotal.ToString("N2")</td></tr>}
<tr><td>خصومات مسجلة</td><td class="money">@i.DeductionsTotal.ToString("N2")</td></tr><tr><td>خصومات أخرى <small>تشمل مصاريف الموظف: @((i.EmployeeExpenseRecoveries??0m).ToString("N2"))</small></td><td class="money">@i.OtherDeductions.ToString("N2")</td></tr><tr class="total-row"><td>إجمالي الخصومات</td><td class="money">@i.TotalDeductions.ToString("N2")</td></tr>
</tbody></table></section></div>
<div class="net-total"><div><span>@(final?"صافي الراتب النهائي":"صافي الراتب المتوقع للدورة")</span><br/><small>إجمالي الاستحقاقات − إجمالي الخصومات</small></div><strong>@i.NetSalary.ToString("N2") @Model.Currency</strong></div>
@if(Model.Notes.Count>0){<div class="section-title">شرح الحساب</div><ul class="hint">@foreach(var note in Model.Notes){<li>@note</li>}</ul>}
<details class="technical-audit no-print"><summary>سجل الحساب المحفوظ للتدقيق</summary><pre>@i.CalculationDetails</pre></details>
</div></div>



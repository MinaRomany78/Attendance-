@model List<EmployeeExpense>
@using HrPayroll.Domain.Enums
@{
    ViewData["Title"] = "مصاريف الموظفين";
    int y = (int)(ViewBag.Year ?? DateTime.Today.Year);
    int? mo = ViewBag.Month as int?;
    string ApprText(ApprovalStatus s) => s == ApprovalStatus.Approved ? "معتمد" : s == ApprovalStatus.Rejected ? "مرفوض" : "قيد المراجعة";
    string SettleText(ExpenseSettlementMode s) => s switch
    {
        ExpenseSettlementMode.DeductFromPayroll => "خصم من الراتب",
        ExpenseSettlementMode.IncludedInAdvance => "مشمول ضمن سلفة",
        ExpenseSettlementMode.PaidCash => "مدفوع نقدًا (توثيق)",
        _ => s.ToString()
    };
}
<partial name="_BackHome" />
<div class="page-hero">
    <div class="page-hero-ico" aria-hidden="true">🧾</div>
    <div class="page-hero-body">
        <h2>مصاريف الموظفين</h2>
        <div class="sub">معاملات مستقلة قابلة للتتبع — إجمالي القابل للخصم المعتمد: @(((decimal)(ViewBag.DeductibleTotal ?? 0m))).ToString("N2") EGP</div>
    </div>
</div>
<div class="card">
    <div class="card-head">
        <h2>المصاريف (@Model.Count)</h2>
        <div class="btn-row">
            <a class="btn btn-ghost btn-sm" asp-action="ExportExcel" asp-route-year="@y" asp-route-month="@(mo ?? DateTime.Today.Month)">تصدير Excel</a>
            <a class="btn btn-primary btn-sm" asp-action="Create">+ تسجيل مصروف</a>
        </div>
    </div>
    <div class="card-body">
        <form method="get" class="filters">
            <div class="field"><label>السنة</label><input type="number" name="year" value="@y" /></div>
            <div class="field"><label>الشهر</label><input type="number" name="month" value="@mo" min="1" max="12" /></div>
            <div class="field"><label>الموظف</label><select name="employeeId" asp-items="ViewBag.Employees"><option value="">الكل</option></select></div>
            <div class="field"><label>بحث</label><input type="text" name="search" value="@ViewBag.Search" placeholder="اسم / كود / فئة" /></div>
            <div class="field actions"><button type="submit" class="btn btn-primary">تصفية</button><a class="btn btn-ghost" asp-action="Index">مسح</a></div>
        </form>
    </div>
    @if (Model.Count == 0)
    {
        ViewData["message"] = "لا توجد مصاريف مسجلة";
        ViewData["hint"] = "سجّل مصروفًا لموظف ثم اعتمده. القابل للخصم يُسوَّى مع كشف نفس الشهر دون ازدواج.";
        ViewData["icon"] = "🧾";
        <partial name="_Empty" />
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                <tr><th>الموظف</th><th>التاريخ</th><th>الفئة</th><th>المبلغ</th><th>الوصف</th><th>الحالة</th><th>التسوية</th><th>مُسوَّى؟</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>@e.Employee?.FullName <span class="hint">@e.Employee?.EmployeeCode</span></td>
                        <td class="num">@e.ExpenseDate.ToString("yyyy-MM-dd")</td>
                        <td>@e.Category</td>
                        <td class="num money">@e.Amount.ToString("N2") @e.Currency</td>
                        <td class="wrap">@(string.IsNullOrWhiteSpace(e.Description) ? "—" : e.Description)</td>
                        <td><span class="badge @(e.Status == ApprovalStatus.Approved ? "ok" : "warn")">@ApprText(e.Status)</span></td>
                        <td>@SettleText(e.SettlementMode)</td>
                        <td>@(e.PayrollItemId.HasValue ? "نعم" : "لا")</td>
                        <td class="btn-row">
                            @if (!e.PayrollItemId.HasValue)
                            {
                                <a class="btn btn-soft btn-sm" asp-action="Edit" asp-route-id="@e.Id">تعديل</a>
                                <form method="post" asp-action="Approve" asp-route-id="@e.Id" class="d-inline" data-confirm="تغيير حالة اعتماد المصروف؟">
                                    <button type="submit" class="btn btn-ghost btn-sm">اعتماد/إلغاء</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@using HrPayroll.Domain.Entities
@{
    ViewData["Title"] = "إدارة واستيراد البصمات";
    var batches = ViewBag.Batches as List<ImportBatch> ?? new List<ImportBatch>();
    var devices = ViewBag.Devices as IReadOnlyList<AttendanceDevice> ?? Array.Empty<AttendanceDevice>();
}
<link rel="stylesheet" href="~/css/attendance-import.css" asp-append-version="true" />
<div class="attendance-import">
    <div class="page-hero">
        <div class="page-hero-ico" aria-hidden="true">⇅</div>
        <div class="page-hero-body">
            <h1>إدارة واستيراد البصمات</h1>
            <p class="sub">ارفع سجلات الجهاز، راجع المطابقة والنتائج، ثم أكّد الاستيراد.</p>
        </div>
        <div class="page-hero-actions">
            <a class="btn btn-ghost" href="#import-history">سجل الاستيراد</a>
            <a class="btn btn-ghost" asp-action="Roster">مطابقة قائمة موظفي الجهاز</a>
        </div>
    </div>
    <ol class="import-steps" aria-label="مراحل الاستيراد">
        <li class="current" aria-current="step"><span>1</span> اختيار الملف</li>
        <li><span>2</span> تحليل ومراجعة</li>
        <li><span>3</span> تأكيد الاستيراد</li>
    </ol>
    <section class="card">
        <div class="card-head"><div><h2>اختر طريقة الاستيراد</h2><p class="sub">تُفحص محتويات الملف قبل حفظ أي بصمات.</p></div></div>
        <div class="card-body">
            <div class="import-methods" role="tablist" aria-label="طرق الاستيراد">
                <button class="import-method active" type="button" role="tab" id="method-combined" aria-controls="pane-combined" aria-selected="true" data-import-tab="combined">
                    <span class="import-method-icon" aria-hidden="true">⇅</span><span><strong>ملف ZKTeco موحد</strong><small>الدخول والخروج في ملف واحد</small></span><span class="import-recommended">موصى به</span>
                </button>
                <button class="import-method" type="button" role="tab" id="method-separate" aria-controls="pane-separate" aria-selected="false" tabindex="-1" data-import-tab="separate">
                    <span class="import-method-icon" aria-hidden="true">⇥</span><span><strong>ملفات منفصلة</strong><small>ملف دخول وملف خروج</small></span>
                </button>
                <button class="import-method" type="button" role="tab" id="method-device" aria-controls="pane-device" aria-selected="false" tabindex="-1" data-import-tab="device">
                    <span class="import-method-icon" aria-hidden="true">▣</span><span><strong>اتصال مباشر بالجهاز</strong><small>إعداد الأجهزة وحالة الدعم</small></span>
                </button>
            </div>
            <div id="pane-combined" class="import-pane" role="tabpanel" aria-labelledby="method-combined" data-import-pane="combined">
                <form method="post" asp-action="Upload" enctype="multipart/form-data" data-attendance-upload data-loading-text="جارٍ تحليل ملف البصمة...">
                    <input type="hidden" name="importMode" value="combined" />
                    <section class="import-dropzone" data-upload-zone>
                        <div class="import-drop-icon" aria-hidden="true">⇩</div>
                        <h2>استيراد ملف البصمة الموحد</h2><p>اسحب ملف ZKTeco هنا أو اختره من جهازك</p>
                        <label class="btn btn-primary import-picker" for="combinedFile">اختيار ملف</label>
                        <input class="import-file-input" type="file" name="combinedFile" id="combinedFile" accept=".txt,.csv,.xlsx,.xls,.xml" data-upload-input aria-describedby="combined-help combined-feedback" />
                        <p class="import-help" id="combined-help">TXT · CSV · XLSX · XLS · XML — حتى 25 ميجابايت<br />يدعم الملفات دون عناوين والأسماء العربية بترميز UTF-8 وWindows-1256</p>
                        <div class="import-selected" data-upload-selected hidden><strong data-upload-name></strong><span data-upload-size></span></div>
                        <p class="import-feedback" id="combined-feedback" data-upload-feedback role="status" aria-live="polite">لم يتم اختيار ملف بعد</p>
                        <button class="btn btn-ghost btn-sm" type="button" data-clear-file hidden>مسح الملف</button>
                    </section>
                    <div class="import-notice"><strong>تحديد الحركة تلقائيًا</strong><span>تُقرأ I كدخول وO كخروج. تُعرض الأكواد غير المطابقة والحركات الغامضة للمراجعة قبل التأكيد.</span></div>
                    <div class="import-form-error alert alert-danger" data-upload-error role="alert" hidden></div>
                    <div class="import-form-actions"><button type="submit" class="btn btn-primary btn-lg">تحليل الملف</button><span class="import-help">المعاينة أولًا، ثم الحفظ بعد تأكيدك</span></div>
                    <div class="import-progress" data-upload-progress hidden role="status" aria-live="polite"><progress aria-label="تحليل الملف"></progress><span>جارٍ رفع الملف وتحليل سجلاته، يرجى الانتظار…</span></div>
                </form>
            </div>
            <div id="pane-separate" class="import-pane" role="tabpanel" aria-labelledby="method-separate" data-import-pane="separate" hidden>
                <form method="post" asp-action="Upload" enctype="multipart/form-data" data-attendance-upload data-loading-text="جارٍ تحليل ملفات البصمة...">
                    <input type="hidden" name="importMode" value="separate" />
                    <div class="import-upload-pair">
                        @foreach (var item in new[] { (Key: "entry", Name: "entryFile", Title: "ملف الدخول", Icon: "↙"), (Key: "exit", Name: "exitFile", Title: "ملف الخروج", Icon: "↗") })
                        {
                            <section class="import-dropzone import-dropzone-small" data-upload-zone>
                                <div class="import-drop-icon" aria-hidden="true">@item.Icon</div><h3>@item.Title</h3><p>اسحب الملف هنا أو اختره</p>
                                <label class="btn btn-soft import-picker" for="@item.Name">اختيار @item.Title</label>
                                <input class="import-file-input" type="file" name="@item.Name" id="@item.Name" accept=".txt,.csv,.xlsx,.xls,.xml" data-upload-input aria-describedby="@(item.Key)-feedback" />
                                <p class="import-help">TXT · CSV · XLSX · XLS · XML — حتى 25 ميجابايت</p>
                                <div class="import-selected" data-upload-selected hidden><strong data-upload-name></strong><span data-upload-size></span></div>
                                <p class="import-feedback" id="@(item.Key)-feedback" data-upload-feedback role="status" aria-live="polite">لم يتم اختيار ملف بعد</p>
                                <button type="button" class="btn btn-ghost btn-sm" data-clear-file hidden>مسح الملف</button>
                            </section>
                        }
                    </div>
                    <p class="import-help">يمكن رفع ملف واحد أو الملفين. اتجاه الحركة الصريح داخل السجل هو المرجع، ويُعرض أي تعارض مع نوع الملف للمراجعة.</p>
                    <div class="import-form-error alert alert-danger" data-upload-error role="alert" hidden></div>
                    <div class="import-form-actions"><button type="submit" class="btn btn-primary btn-lg">تحليل الملفات</button></div>
                    <div class="import-progress" data-upload-progress hidden role="status" aria-live="polite"><progress aria-label="تحليل الملفات"></progress><span>جارٍ رفع الملفات وتحليل السجلات…</span></div>
                </form>
            </div>
            <div id="pane-device" class="import-pane" role="tabpanel" aria-labelledby="method-device" data-import-pane="device" hidden>
                <div class="import-device-empty"><div class="import-drop-icon" aria-hidden="true">▣</div><h2>إدارة الاتصال بأجهزة ZKTeco</h2><p>احفظ عنوان الجهاز وموديله ومنطقته الزمنية من شاشة الأجهزة. تعتمد إمكانية الاتصال وتنزيل البصمات على توفر برنامج تشغيل موثّق متوافق مع الموديل.</p><span class="import-status review">الاتصال المباشر غير مفعّل حتى توفير برنامج تشغيل متوافق</span><div class="btn-row"><a class="btn btn-primary" asp-controller="AttendanceDevices" asp-action="Index">إدارة الأجهزة المحفوظة</a></div></div>
                @if (devices.Count > 0)
                {
                    <div class="table-wrap"><table class="data import-table"><thead><tr><th scope="col">الجهاز</th><th scope="col">العنوان</th><th scope="col">الحالة</th><th scope="col">آخر مزامنة ناجحة</th></tr></thead><tbody>
                    @foreach (var device in devices)
                    {
                        <tr><td><strong>@device.Name</strong><small class="import-cell-sub">@device.Model</small></td><td class="num">@device.IpAddress:@device.TcpPort</td><td><span class="import-status review">برنامج تشغيل غير مهيأ</span></td><td class="num">@(device.LastSuccessfulSyncUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "لم تتم المزامنة")</td></tr>
                    }
                    </tbody></table></div>
                }
            </div>
        </div>
    </section>
    <section class="card" id="import-history">
        <div class="card-head"><div><h2>سجل عمليات الاستيراد</h2><p class="sub">آخر 30 عملية مع ملخص السجلات ونتيجة التحقق.</p></div><span class="import-count">@batches.Count عملية</span></div>
        @if (batches.Count == 0)
        {
            <div class="import-empty"><span aria-hidden="true">▤</span><h3>لا توجد عمليات استيراد بعد</h3><p>ابدأ بتحليل ملف البصمة؛ ستظهر العمليات المؤكدة هنا.</p></div>
        }
        else
        {
            <div class="table-wrap"><table class="data import-table"><caption class="visually-hidden">سجل استيراد البصمات</caption><thead><tr><th scope="col">الملف</th><th scope="col">الصيغة</th><th scope="col">التاريخ</th><th scope="col">المستخدم</th><th scope="col">إجمالي</th><th scope="col">مستورد</th><th scope="col">مكرر</th><th scope="col">غير صالح</th><th scope="col">غير مطابق</th><th scope="col">التفاصيل</th></tr></thead><tbody>
            @foreach (var b in batches)
            {
                <tr><td class="wrap"><strong>@b.FileName</strong></td><td>@(b.DetectedFormat ?? "—")</td><td class="num">@b.ImportedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td>@(b.ImportedByName ?? "—")</td><td class="num">@b.TotalRows</td><td class="num">@b.SuccessRows</td><td class="num">@b.DuplicateRows</td><td class="num">@b.InvalidRows</td><td class="num">@b.UnknownEmployeeRows</td><td><a class="btn btn-soft btn-sm" asp-action="Details" asp-route-id="@b.Id" aria-label="تفاصيل استيراد @b.FileName">عرض</a></td></tr>
            }
            </tbody></table></div>
        }
    </section>
</div>
@section Scripts { <script src="~/js/attendance-import.js" asp-append-version="true"></script> }

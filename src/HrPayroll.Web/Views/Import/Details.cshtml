@model HrPayroll.Web.ViewModels.ImportDetailsVm
@{ Layout = "_Layout"; ViewData["Title"] = "تفاصيل دفعة الاستيراد"; }
<h2>تفاصيل دفعة الاستيراد #@Model.Batch.Id</h2>
<div class="card mb-3">
    <div class="card-body">
        <div><strong>النوع:</strong> @Model.Batch.ImportType</div>
        <div><strong>الملف:</strong> @Model.Batch.FileName</div>
        <div><strong>الصفوف:</strong> إجمالي @Model.Batch.RowCount — ناجح @Model.Batch.SuccessCount — فاشل @Model.Batch.FailureCount</div>
        <div><strong>الحالة:</strong> @Model.Batch.Status — رفعها @Model.Batch.UploadedBy في @Model.Batch.UploadedAt.ToString("yyyy-MM-dd HH:mm")</div>
        @if (!string.IsNullOrWhiteSpace(Model.Batch.SummaryJson))
        {
            <div class="mt-2"><strong>الملخص:</strong> @Model.Batch.SummaryJson</div>
        }
    </div>
</div>
<div class="mb-3">
    @await Html.PartialAsync("_BackHome", "عودة")
</div>
